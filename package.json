{
  "name": "staruml-mcp",
  "version": "0.6.0",
  "mcpName": "io.github.hqqw2h-lgtm/staruml-mcp",
  "description": "Model Context Protocol server for StarUML — generate UML diagrams from AI agents (Claude Code, Cursor, VS Code, Codex). Supports both stdio and Streamable HTTP transports.",
  "keywords": [
    "mcp",
    "staruml",
    "uml",
    "diagram",
    "model-context-protocol",
    "ai-agent",
    "claude",
    "cursor"
  ],
  "author": {
    "name": "Ezra Brilliant Konterliem",
    "email": "ezrakonterliem@gmail.com",
    "url": "https://github.com/ezrabrilliant"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hqqw2h-lgtm/staruml-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/hqqw2h-lgtm/staruml-mcp/issues"
  },
  "homepage": "https://github.com/hqqw2h-lgtm/staruml-mcp#readme",
  "type": "module",
  "bin": {
    "staruml-mcp": "dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:live": "STARUML_LIVE=1 vitest run tests/live",
    "test:mutation": "stryker run",
    "load-test": "node scripts/load-test.mjs",
    "soak-test": "node scripts/soak-test.mjs",
    "benchmark:tokens": "node --import tsx scripts/token-benchmark.mjs",
    "sync:manifest": "node scripts/sync-manifest.mjs",
    "sync:skills": "node scripts/sync-skills.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint src tests scripts",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.mjs\"",
    "prepare": "husky",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "commander": "^12.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.0.0",
    "fast-check": "^4.10.2",
    "gpt-tokenizer": "^4.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.3.0",
    "supertest": "^7.0.0",
    "tsup": "^8.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.58.2",
    "vitest": "^2.0.0"
  },
  "lint-staged": {
    "*.{ts,mts,cts,js,mjs,cjs}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,yml,yaml}": "prettier --write"
  }
}
